# Copy to `.env` and adjust. NEVER commit the real .env file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=recipeapp
POSTGRES_USER=recipeapp
POSTGRES_PASSWORD=change-me

# --- Backend ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Bootstrap admin account (created on first start)
ADMIN_EMAIL=admin@recipeapp.dev
ADMIN_PASSWORD=Admin123!

# Comma-separated origins, or * for development
CORS_ALLOWED_HOSTS=*
